{
  "name": "dsh-subagent",
  "version": "0.1.0",
  "description": "Named subagent profiles with configurable model routing and reasoning for DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xie-tj/dsh-subagent.git"
  },
  "homepage": "https://github.com/xie-tj/dsh-subagent#readme",
  "bugs": {
    "url": "https://github.com/xie-tj/dsh-subagent/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./invariant": "./invariant.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "invariant.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test tests/smoke.mjs tests/client.mjs tests/composition.mjs",
    "test:composition": "node --test tests/composition.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
